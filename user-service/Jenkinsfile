pipeline{
    agent any

    tools{
        jdk 'jdk-17'
        maven 'maven-3.9'
    }

    environment {
        AWS_ACCOUNT_ID = '581237506066'
        AWS_REGION = 'ap-south-1'
        ECR_REPOSITORY = 'med-erp/user-service'
    }

    stages{

        stage("Checkout"){
            steps{
                sh '''
                    java -version
                    javac -version
                    mvn -version
                '''
                echo "Checkout phase completed"
            }
        }

        stage("Docker-Build"){
            steps{
                dir('user-service'){
                    echo "Jenkins Build Number: ${BUILD_NUMBER}"
                     sh "docker build -t ${AWS_ACCOUNT_ID}.dkr.ecr.ap-south-1.amazonaws.com/med-erp/user-service:${BUILD_NUMBER} ."
                }
            }
        }
    }
}