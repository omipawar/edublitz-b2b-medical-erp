pipeline{
    agent any

    tools{
        jdk 'jdk-17'
        maven 'maven-3.9'
    }

    environment {
        AWS_ACCOUNT_ID = '581237506066'
        AWS_REGION = 'ap-south-1'
        ECR_REPOSITORY = 'med-erp/user-service'
        IMAGE_TAG = "${BUILD_NUMBER}"
        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    }

    stages{

        stage("Checkout"){
            steps{
                sh '''
                    java -version
                    javac -version
                    mvn -version
                '''
                echo "Checkout phase completed"
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'sonar-scanner'

                    dir('user-service') {
                        withSonarQubeEnv('SonarQube') {
                            sh """
                                "\${scannerHome}/bin/sonar-scanner" \
                                -Dsonar.projectKey=med-erp-user-service \
                                -Dsonar.projectName="med-erp/user-service" \
                                -Dsonar.sources=src \
                                -Dsonar.java.binaries=target/classes
                            """
                        }
                    }
                }
            }
        }

        stage("Quality Gate") {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    script {
                        def qg = waitForQualityGate()

                        if (qg.status != 'OK') {
                            error "Pipeline stopped: Quality Gate status: ${qg.status}"
                        }

                        echo "SonarQube Quality Gate passed"
                    }
                }
            }
        }

        stage("Docker-Build"){
            steps{
                dir('user-service'){
                    echo "Jenkins Build Number: ${BUILD_NUMBER}"
                     sh "docker build -t ${ECR_REGISTRY}/med-erp/user-service:${BUILD_NUMBER} ."
                }
            }
        }

        stage("ECR-Login"){
            steps{
                sh '''
                    aws ecr get-login-password --region ${AWS_REGION} | 
                    docker login --username AWS --password-stdin ${ECR_REGISTRY}
                '''
            }
        }

        stage("Docker-Push"){
            steps{
                sh '''
                    docker push "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"
                '''
            }
        }
    }
    
    post {
        always {
            echo "🔄 Pipeline execution completed"
        }

        success {
            echo "✅ Deployment successful"
        }

        failure {
            echo "❌ Deployment failed"
        }
    }
}