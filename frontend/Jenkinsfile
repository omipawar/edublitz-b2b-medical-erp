pipeline{
    agent any

    tools{
        nodejs 'node-22'
    }

    stages{

        stage("Checkout"){
            steps{
                echo "Checkout phase completed"
            }
        }

        stage("Build"){
            when{
                changeset "frontend/**"
            }
            steps{
                dir('frontend'){
                    sh 'npm install'
                    sh 'npm run build'
                }
            }
        }
    }
}